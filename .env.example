# ACE Dashboard — environment template. PLACEHOLDERS ONLY; never commit real values.
# Copy to .env (gitignored). Secrets belong in the environment / Supabase config,
# NEVER in frontend code, GitHub Pages assets, or committed files.

# --- Toast partner API (used by scripts/ingest-toast.mjs and the ingest Edge Function)
TOAST_CLIENT_ID=__REQUIRED__
TOAST_CLIENT_SECRET=__REQUIRED__
TOAST_RESTAURANT_GUID=e574444c-c511-4468-ab89-93d0abbec72b   # Chasin' Tails Founders Row (not secret)

# --- Toast nightly export (ToastNightlyExportAdapter — not yet configured)
TOAST_EXPORT_SFTP_HOST=__PENDING_TOAST_SUPPORT__
TOAST_EXPORT_SFTP_KEY=__PENDING_TOAST_SUPPORT__

# --- MarginEdge public API (scripts/sync-marginedge-costs.mjs + the daily
#     "MarginEdge cost sync" workflow). READ-ONLY: every documented endpoint is
#     GET and the client refuses anything else. Server-side only — the key must
#     never reach the browser or a committed file.
#     The unit id is the MarginEdge restaurantUnitId, from GET /restaurantUnits.
MARGINEDGE_API_KEY=__REQUIRED_FOR_COST_SYNC__
MARGINEDGE_RESTAURANT_UNIT_ID=377809302   # Nue/Chasin' Tails - Falls Church (not secret)

# --- OpenTable (OpenTableSyncApiAdapter — production access NOT granted yet)
OPENTABLE_CLIENT_ID=__PENDING_OPENTABLE_APPROVAL__
OPENTABLE_CLIENT_SECRET=__PENDING_OPENTABLE_APPROVAL__

# --- Supabase
# SUPABASE_DB_URL is the single most important value in this file: nightly Toast
# ingestion, the MarginEdge cost sync, the audit and every admin script read it.
# Both GitHub Actions workflows need it as a repository secret.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=__REQUIRED__

# Admin scripts ONLY (add-manager, verify-live, deploy-supabase). Not needed by
# either scheduled workflow — do NOT add the service-role key to CI.
SUPABASE_URL=__REQUIRED_FOR_ADMIN_SCRIPTS__
SUPABASE_SERVICE_ROLE_KEY=__SERVER_SIDE_ONLY__      # bypasses ALL row-level security. NEVER in browser/frontend/CI.

# The browser does NOT read a key from here — it reads the publishable key from
# data/supabase_config.json, which is committed on purpose (read-only, PII-free
# tables, and every write RPC requires a signed-in approved manager).

# --- GitHub (one-off: scripts/admin/set-github-token.mjs stores this in the
#     Supabase Vault as ace_github_pat so managers can retry the nightly run).
#     Use a fine-grained PAT scoped to this repo with Actions: write.
GITHUB_TOKEN=__ONE_OFF_ADMIN_ONLY__

# --- Payroll (feature-flagged off; source not yet approved)
PAYROLL_SOURCE=__UNDECIDED__
